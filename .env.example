########################################################################
# clinical-rag-agent — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA faça commit do arquivo `.env` preenchido (já está no .gitignore).
#
# IMPORTANTE: as credenciais dos bancos e-SUS e Sistema IS devem ser de um
# usuário com permissão SOMENTE LEITURA (GRANT SELECT). O serviço também
# força `SET default_transaction_read_only = on` na conexão como camada
# extra de proteção, mas isso não substitui a criação do usuário read-only
# no banco.
########################################################################

# ------------------------------------------------------------------
# Ambiente geral
# ------------------------------------------------------------------
APP_ENV=development
APP_NAME=clinical-rag-agent
LOG_LEVEL=INFO

# Chave que o Sistema IS (frontend/backend principal) deve enviar no header
# `X-API-Key` para autenticar-se neste microserviço.
SERVICE_API_KEY=troque-por-uma-chave-forte-gerada-com-openssl-rand-hex-32

# ------------------------------------------------------------------
# Fonte 1a — Banco e-SUS APS (PostgreSQL) — SOMENTE LEITURA
# ------------------------------------------------------------------
ESUS_DB_HOST=
ESUS_DB_PORT=5432
ESUS_DB_NAME=esus_aps
ESUS_DB_USER=leitura_rag_agent
ESUS_DB_PASSWORD=
ESUS_DB_SCHEMA=public
# Pool pequeno: este serviço não deve competir com a carga transacional do e-SUS
ESUS_DB_POOL_SIZE=3
ESUS_DB_STATEMENT_TIMEOUT_MS=15000
ESUS_DB_SSLMODE=prefer

# ------------------------------------------------------------------
# Fonte 1b — Banco Sistema IS (PostgreSQL, aplicação própria) — SOMENTE LEITURA
# ------------------------------------------------------------------
SISTEMA_IS_DB_HOST=
SISTEMA_IS_DB_PORT=5432
SISTEMA_IS_DB_NAME=sistema_is
SISTEMA_IS_DB_USER=leitura_rag_agent
SISTEMA_IS_DB_PASSWORD=
SISTEMA_IS_DB_SCHEMA=public
SISTEMA_IS_DB_POOL_SIZE=3
SISTEMA_IS_DB_STATEMENT_TIMEOUT_MS=15000
SISTEMA_IS_DB_SSLMODE=prefer

# ------------------------------------------------------------------
# Banco próprio do microserviço (leitura/escrita) — cache, vetores, auditoria
# Requer extensão `pgvector` habilitada.
# ------------------------------------------------------------------
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=clinical_rag_agent
APP_DB_USER=clinical_rag_agent
APP_DB_PASSWORD=troque-esta-senha
APP_DB_POOL_SIZE=10

# Redis (opcional, mas recomendado): cache de respostas de curtíssimo prazo e
# fila de jobs de pré-geração da Situação 1. Se vazio, o serviço funciona sem
# Redis usando apenas o cache em Postgres (com mais latência).
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# LLM — Anthropic Claude API
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo "caro" para síntese clínica e raciocínio diagnóstico (Situação 1 e 2)
LLM_MODEL_PRIMARY=claude-sonnet-5
# Modelo barato para roteamento, triagem de necessidade de busca, extração
LLM_MODEL_FAST=claude-haiku-4-5-20251001
# Orçamento diário de segurança (USD). Ao atingir, novas chamadas "primary"
# passam a exigir confirmação/degradam para o modelo fast (circuit breaker).
LLM_DAILY_BUDGET_USD=200
# Ativa a Message Batches API para geração assíncrona em lote (Situação 1)
LLM_USE_BATCH_API=true

# ------------------------------------------------------------------
# Embeddings (RAG) — padrão local (custo zero por chamada, roda em CPU)
# ------------------------------------------------------------------
# Provider: "local" (sentence-transformers, recomendado para custo em escala)
# ou "voyage" (Voyage AI, maior qualidade, cobrado por token)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDINGS_DIM=768
# Necessário apenas se EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=

# ------------------------------------------------------------------
# Ingestão de fontes médico-científicas (Fonte 2)
# ------------------------------------------------------------------
# NCBI E-utilities: gratuito, mas um e-mail e (opcional) API key aumentam o
# rate limit de 3 para 10 req/s. https://www.ncbi.nlm.nih.gov/books/NBK25497/
NCBI_EUTILS_EMAIL=
NCBI_EUTILS_API_KEY=
# Endpoint do Portal de Dados Abertos do SUS (PCDT)
DADOSABERTOS_SAUDE_BASE_URL=https://dadosabertos.saude.gov.br

# ------------------------------------------------------------------
# Identidade do paciente entre as duas bases
# ------------------------------------------------------------------
# Campo usado para casar o mesmo paciente entre e-SUS e Sistema IS.
# Valores esperados: "cpf" | "cns" | "external_id_map"
PATIENT_IDENTITY_KEY=cpf
