# =============================================================================
# AtendValida - variáveis de ambiente
# Copie este arquivo para `.env` na raiz do projeto e ajuste os valores.
# Nunca commit o arquivo `.env` real (ele já está no .gitignore).
# =============================================================================

# --- Banco de dados (PostgreSQL) --------------------------------------------
# Usado tanto pelo docker-compose (para criar o container) quanto pela API.
# Se você rodar a API fora do Docker, ajuste o host/porta conforme seu ambiente.
POSTGRES_USER=atendvalida
POSTGRES_PASSWORD=atendvalida
POSTGRES_DB=atendvalida
# String de conexão completa usada pelo Prisma. Ao rodar via docker-compose,
# a API sobrescreve isso automaticamente para apontar para o serviço "postgres".
DATABASE_URL="postgresql://atendvalida:atendvalida@localhost:5432/atendvalida?schema=public"

# --- Redis --------------------------------------------------------------
# Usado para armazenamento de OTP/rate-limiting e como backend das filas BullMQ
# (envio de notificações, geração de PDF, entrega de webhooks).
REDIS_URL="redis://localhost:6379"

# --- API ------------------------------------------------------------------
# Porta em que a API HTTP vai escutar.
PORT=3000
# Ambiente de execução ("development" habilita logs coloridos/legíveis).
NODE_ENV=development
# Nível de log (fatal, error, warn, info, debug, trace).
LOG_LEVEL=info
# Origens permitidas para CORS, separadas por vírgula. Use "*" para liberar
# geral (seguro aqui pois a autenticação é via Bearer JWT, não cookies).
CORS_ORIGINS="*"
# Diretório onde os PDFs de comprovante são gravados localmente.
# Em produção, troque a implementação de PdfService para gravar em um bucket
# de objetos (S3/GCS) em vez do disco local.
STORAGE_DIR="./storage/comprovantes"

# --- Autenticação (client-credentials: api_key_id + api_secret -> JWT) -----
# Segredo usado para assinar os JWTs de curta duração emitidos em
# POST /v1/auth/token. Gere um valor aleatório forte em produção, ex.:
#   openssl rand -hex 32
JWT_SECRET="troque-este-valor-em-producao"
# Tempo de vida do JWT emitido, em segundos.
JWT_EXPIRES_IN_SECONDS=900
# Token estático que protege os endpoints de uso interno do operador do
# AtendValida (criação de tenants, rotação de api_key). Mantenha em segredo
# e restrinja o acesso à rede interna/administrativa.
OPERATOR_TOKEN="troque-este-token-de-operador"

# --- Criptografia de dados sensíveis (estilo KMS) ---------------------------
# Chave mestre usada pela implementação local (AES-256-GCM) para criptografar
# telefones, segredos de webhook e credenciais de provedores em repouso.
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
# Em produção, substitua LocalKmsProvider por uma implementação que delegue
# a um KMS gerenciado (AWS KMS, HashiCorp Vault, GCP KMS) — ver README.
KMS_LOCAL_KEY="troque-esta-chave-mestre-em-producao"

# --- Assinatura digital dos comprovantes (Ed25519) --------------------------
# Chave privada Ed25519 (PEM) usada para assinar o hash SHA-256 de cada
# comprovante, tornando-o tamper-evident. Gere um par de chaves com:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}).toString())"
# Cole o PEM abaixo substituindo as quebras de linha reais por "\n".
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA_PELA_SUA_CHAVE\n-----END PRIVATE KEY-----"

# --- Front-ends (build-time) -------------------------------------------------
# URL base da API usada pelos apps React (capture-app e admin-panel) para
# montar as chamadas fetch. Definida em tempo de build do Vite.
VITE_API_BASE_URL="http://localhost:3000/v1"
