# =============================================================================
# Banco de dados do e-SUS (ORIGEM) - usuario SOMENTE LEITURA
# =============================================================================
ESUS_DB_HOST=
ESUS_DB_PORT=5432
ESUS_DB_NAME=
ESUS_DB_USER=
ESUS_DB_PASSWORD=
# "require" recomendado em producao; "disable" apenas para testes locais
ESUS_DB_SSL_MODE=require

# =============================================================================
# Banco de dados do Sistema IS (DESTINO) - usuario com permissao de escrita
# apenas nas tabelas que sotech.esus_criar_chamada ja utiliza
# =============================================================================
IS_DB_HOST=
IS_DB_PORT=5432
IS_DB_NAME=
IS_DB_USER=
IS_DB_PASSWORD=
IS_DB_SSL_MODE=require

# =============================================================================
# Parametros do worker de sincronizacao
# =============================================================================
# Intervalo entre ciclos de polling (ms)
POLL_INTERVAL_MS=5000
# Quantidade maxima de mudancas de status processadas por ciclo
POLL_BATCH_SIZE=200
# Caminho do arquivo SQLite com o estado interno do worker (watermark, cache de
# status e log de auditoria). Nao e uma estrutura do e-SUS nem do IS.
STATE_DB_PATH=./data/state.db
# Se true, detecta e loga as chamadas que seriam disparadas mas NAO grava no IS
# (usar durante a validacao antes de ir para producao)
SYNC_DRY_RUN=false
# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info
# Porta do endpoint HTTP de healthcheck
HEALTH_PORT=3000
